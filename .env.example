# Server
PORT=8787
CLIENT_ORIGIN=http://localhost:5173

# Demo mode (true = sample messages only; leave false to paste live stream links)
DEMO_MODE=false

# Twitch — https://dev.twitch.tv/console/apps
# Anonymous IRC works for reading public chat; Helix improves badge images & channel resolve
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=
# Optional: OAuth token for authenticated IRC (not required for read-only public chat)
# TWITCH_ACCESS_TOKEN=

# YouTube — paste a live link; no API key required (Innertube / youtubei.js).
# Optional: official Data API v3 fallback if Innertube fails:
#   https://console.cloud.google.com/apis/credentials (enable YouTube Data API v3)
YOUTUBE_API_KEY=

# TikTok — unofficial connector (tiktok-live-connector v2); no official API keys
# Creator must be LIVE to connect. No Euler Business plan required for chat.
# Gift catalog prefetch is disabled; gift events still arrive over the WebSocket.
#
# IMPORTANT — full chat vs gifts:
#   Anonymous connections often receive Gifts but TikTok heavily filters Chat.
#   For full chat, set a logged-in session (authenticateWs) below.
#
# Recommended for chat (Windows desktop → %APPDATA%\Chorus\.env):
#   1. Log into tiktok.com in Chrome/Edge
#   2. DevTools → Application → Cookies → https://www.tiktok.com
#   3. Copy `sessionid` → TIKTOK_SESSION_ID=...
#   4. Optionally copy `tt-target-idc` → TIKTOK_TT_TARGET_IDC=... (default useast1a)
#   5. Restart Chorus and reconnect while the creator is LIVE
#
# Optional fallbacks if connect still fails (do NOT buy Business):
#   - Free Euler Community API key: TIKTOK_SIGN_API_KEY (https://www.eulerstream.com)
TIKTOK_SESSION_ID=
# TIKTOK_TT_TARGET_IDC=useast1a
# TIKTOK_SIGN_API_KEY=
# SIGN_API_KEY=
