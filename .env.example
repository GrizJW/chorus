# Server
PORT=8787
CLIENT_ORIGIN=http://localhost:5173

# Demo mode (true = sample messages only; leave false to paste live stream links)
DEMO_MODE=false

# Twitch — https://dev.twitch.tv/console/apps
# Anonymous IRC works for reading public chat; Helix improves badge images & channel resolve
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=
# Optional: OAuth token for authenticated IRC (not required for read-only public chat)
# TWITCH_ACCESS_TOKEN=

# YouTube — https://console.cloud.google.com/apis/credentials
# Enable "YouTube Data API v3". API key is enough for public live chat polling.
YOUTUBE_API_KEY=

# TikTok — unofficial connector (tiktok-live-connector v2); no official API keys
# Creator must be LIVE to connect.
# If you see "Failed to sign request" / 403, set your TikTok sessionid cookie:
#   1. Log into tiktok.com in a browser
#   2. DevTools → Application → Cookies → copy the value of `sessionid`
#   3. Windows desktop: put it in %APPDATA%\Chorus\.env as TIKTOK_SESSION_ID=...
#   4. Optionally also set TIKTOK_TT_TARGET_IDC from the `tt-target-idc` cookie (default useast1a)
TIKTOK_SESSION_ID=
# TIKTOK_TT_TARGET_IDC=useast1a
# Optional Euler Stream API key (https://www.eulerstream.com) if free signing is rate-limited:
# TIKTOK_SIGN_API_KEY=
# SIGN_API_KEY=
